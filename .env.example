PORT=5000
MONGO_URI=mongodb+srv://<username>:<password-with-url-encoded-special-chars>@cluster.mongodb.net/sylva_technologies
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=7d

# KRA GavaConnect PIN Checker BY ID (sandbox by default)
KRA_BASE_URL=https://sbx.kra.go.ke
KRA_CONSUMER_KEY=
KRA_CONSUMER_SECRET=
CLIENT_URL=https://sylva-technologies-frontend.vercel.app,https://sylva-technologies-frontend-jucbjftlx.vercel.app
# Optional comma-separated exact preview origins allowed by production CORS.
VERCEL_PREVIEW_ORIGINS=


# Google OAuth 2.0 web client. Register the exact callback URI in Google Cloud Console.
# Authorized redirect URI: https://api.sylvatechnologies.co.ke/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.sylvatechnologies.co.ke/api/auth/google/callback

# Outbound email is sent through Resend (no SMTP credentials are used).
RESEND_API_KEY=
EMAIL_FROM=Sylva Technologies <no-reply@sylvatechnologies.co.ke>
EMAIL_FROM_VERIFICATION=Sylva Technologies <verification@sylvatechnologies.co.ke>
EMAIL_FROM_PASSWORD_RESET=Sylva Technologies <resetpassword@sylvatechnologies.co.ke>
EMAIL_FROM_ORDERS=Sylva Technologies <order@sylvatechnologies.co.ke>
EMAIL_FROM_ADMIN=Sylva Technologies <admin@sylvatechnologies.co.ke>
EMAIL_FROM_SALES=Sylva Technologies <sales@sylvatechnologies.co.ke>
EMAIL_FROM_SUPPORT=Sylva Technologies <support@sylvatechnologies.co.ke>
EMAIL_FROM_SELLERS=Sylva Technologies <sellers@sylvatechnologies.co.ke>
ADMIN_EMAIL=admin@sylvatechnologies.co.ke
SALES_EMAIL=sales@sylvatechnologies.co.ke

SMS_PROVIDER=twilio
SMS_API_KEY=your_sms_api_key
SMS_USERNAME=your_sms_username
SMS_SENDER_ID=SYLVA

OTP_EXPIRY_MINUTES=10
RESEND_COOLDOWN_MINUTES=1
MAX_OTP_ATTEMPTS=5
MAX_OTP_REQUESTS=3
WHATSAPP_NUMBER=254700932014
# Daraja M-Pesa STK Push for wallet deposits and order checkout.
# Keep sandbox for local development. Use production only after Safaricom confirms Go Live
# and the production credentials/passkey for the approved shortcode.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://sylva-technologies-backend.onrender.com/api/wallet/topup/stk/callback
MPESA_ORDER_CALLBACK_URL=https://sylva-technologies-backend.onrender.com/api/orders/mpesa/callback
# Till / Buy Goods: CustomerBuyGoodsOnline and the approved Till in MPESA_TILL_NUMBER.
# PayBill: CustomerPayBillOnline; MPESA_TILL_NUMBER can be blank.
# If transaction type is blank, code infers Buy Goods when a Till number is supplied.
MPESA_TRANSACTION_TYPE=
MPESA_TILL_NUMBER=
PAYPAL_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for Sylva Mail message and attachment encryption; generate a unique 32-byte key.
MAIL_ATTACHMENT_ENCRYPTION_KEY=

# Sylva AI product intelligence engine. Qwen runs behind the private model endpoint.
# Do not set localhost for Render: it refers to the Render container, not your Windows PC.
# Keep this endpoint private and protected by network controls / TLS where possible.
OLLAMA_BASE_URL=
# Optional Cloudflare Access service-token credentials for a protected remote Ollama endpoint.
# Keep actual values in local .env / Render environment variables only; never commit secrets.
OLLAMA_ACCESS_CLIENT_ID=
OLLAMA_ACCESS_CLIENT_SECRET=
OLLAMA_MODEL=qwen2.5:3b
# Secondary local model on the same private Ollama endpoint; tried before Cloudflare Workers AI.
OLLAMA_FALLBACK_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_MS=90000

# Optional secondary provider; keep disabled until Cloudflare Workers AI credentials are added to Render.
SYLVA_AI_FALLBACK_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SYLVA_AI_FALLBACK_MODEL=@cf/meta/llama-3.1-8b-instruct
SYLVA_AI_PRIMARY_COOLDOWN_MS=30000
SYLVA_AI_FALLBACK_MAX_TOKENS=2048
SYLVA_AI_WORKER_INTERVAL_MS=15000
# Keep disabled during local model testing; enable only after endpoint and queue review.
SYLVA_AI_WORKER_ENABLED=false


# AliExpress Open Platform IOP OAuth. The redirect URI must exactly match the app console.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_REDIRECT_URI=
# Catalogue sync stays disabled until AliExpress confirms a supported IOP supplier-catalogue
# method and grants its API permission to the existing App ID 40465.
# Generate a unique 32-byte hexadecimal key for encrypted supplier tokens.
ALIEXPRESS_TOKEN_ENCRYPTION_KEY=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Finance-approved KES per USD rate used to convert KES orders for PayPal checkout.
PAYPAL_KES_PER_USD=
FRONTEND_URL=https://www.sylvatechnologies.co.ke
# Meta Facebook Login / Page publishing. Register this exact redirect URI in Meta Login settings.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://api.sylvatechnologies.co.ke/api/meta/facebook/callback
META_GRAPH_API_VERSION=v27.0
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
META_TOKEN_ENCRYPTION_KEY=
# Public API endpoint Meta calls for user-data deletion status checks.
META_DATA_DELETION_STATUS_URL=https://api.sylvatechnologies.co.ke/api/meta/facebook/data-deletion
WALLET_KES_PER_USD=
PLATFORM_COMMISSION_RATE_BPS=400
