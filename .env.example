PORT=5000
MONGO_URI=mongodb+srv://<username>:<password-with-url-encoded-special-chars>@cluster.mongodb.net/sylva_technologies
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=7d

# KRA GavaConnect PIN Checker BY ID (sandbox by default)
KRA_BASE_URL=https://sbx.kra.go.ke
KRA_CONSUMER_KEY=
KRA_CONSUMER_SECRET=
CLIENT_URL=https://sylva-technologies-frontend.vercel.app,https://sylva-technologies-frontend-jucbjftlx.vercel.app

# Outbound email is sent through Resend (no SMTP credentials are used).
RESEND_API_KEY=
EMAIL_FROM=Sylva Technologies <no-reply@sylvatechnologies.co.ke>
EMAIL_FROM_VERIFICATION=Sylva Technologies <verification@sylvatechnologies.co.ke>
EMAIL_FROM_PASSWORD_RESET=Sylva Technologies <resetpassword@sylvatechnologies.co.ke>
EMAIL_FROM_ORDERS=Sylva Technologies <order@sylvatechnologies.co.ke>
EMAIL_FROM_ADMIN=Sylva Technologies <admin@sylvatechnologies.co.ke>
EMAIL_FROM_SALES=Sylva Technologies <sales@sylvatechnologies.co.ke>
EMAIL_FROM_SUPPORT=Sylva Technologies <support@sylvatechnologies.co.ke>
EMAIL_FROM_SELLERS=Sylva Technologies <sellers@sylvatechnologies.co.ke>
ADMIN_EMAIL=admin@sylvatechnologies.co.ke
SALES_EMAIL=sales@sylvatechnologies.co.ke

SMS_PROVIDER=twilio
SMS_API_KEY=your_sms_api_key
SMS_USERNAME=your_sms_username
SMS_SENDER_ID=SYLVA

OTP_EXPIRY_MINUTES=10
RESEND_COOLDOWN_MINUTES=1
MAX_OTP_ATTEMPTS=5
MAX_OTP_REQUESTS=3
WHATSAPP_NUMBER=254700932014
# Daraja M-Pesa STK Push for wallet deposits and order checkout.
# Keep sandbox for local development. Use production only after Safaricom confirms Go Live
# and the production credentials/passkey for the approved shortcode.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://sylva-technologies-backend.onrender.com/api/wallet/topup/stk/callback
MPESA_ORDER_CALLBACK_URL=https://sylva-technologies-backend.onrender.com/api/orders/mpesa/callback
# Till / Buy Goods: CustomerBuyGoodsOnline and the approved Till in MPESA_TILL_NUMBER.
# PayBill: CustomerPayBillOnline; MPESA_TILL_NUMBER can be blank.
# If transaction type is blank, code infers Buy Goods when a Till number is supplied.
MPESA_TRANSACTION_TYPE=
MPESA_TILL_NUMBER=
PAYPAL_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Required for Sylva Mail message and attachment encryption; generate a unique 32-byte key.
MAIL_ATTACHMENT_ENCRYPTION_KEY=

# AliExpress Open Platform IOP OAuth. The redirect URI must exactly match the app console.
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_REDIRECT_URI=
# Legacy Dropshipping/TOP gateway credential slots. Use the App Key/Secret AliExpress confirms for this gateway.
# They may match the IOP values if AliExpress confirms the same pair; do not invent a second pair.
ALIEXPRESS_DS_APP_KEY=
ALIEXPRESS_DS_APP_SECRET=
# Generate a unique 32-byte hexadecimal key for encrypted supplier tokens.
ALIEXPRESS_TOKEN_ENCRYPTION_KEY=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Finance-approved KES per USD rate used to convert KES orders for PayPal checkout.
PAYPAL_KES_PER_USD=
FRONTEND_URL=https://www.sylvatechnologies.co.ke
WALLET_KES_PER_USD=
PLATFORM_COMMISSION_RATE_BPS=400
