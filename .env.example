# Application
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sylva_technologies
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=7d

# KRA integration
KRA_BASE_URL=https://sbx.kra.go.ke
KRA_CONSUMER_KEY=
KRA_CONSUMER_SECRET=

# Frontend origins
CLIENT_URL=https://sylva-technologies-frontend.vercel.app,https://sylva-technologies-frontend-jucbjftlx.vercel.app

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM_VERIFICATION=Sylva Technologies <verification@sylvatechnologies.co.ke>
EMAIL_FROM_PASSWORD_RESET=Sylva Technologies <resetpassword@sylvatechnologies.co.ke>
EMAIL_FROM_ORDERS=Sylva Technologies <order@sylvatechnologies.co.ke>
EMAIL_FROM_SALES=Sylva Technologies <sales@sylvatechnologies.co.ke>
EMAIL_FROM_SUPPORT=Sylva Technologies <support@sylvatechnologies.co.ke>
EMAIL_FROM_SELLERS=Sylva Technologies <sellers@sylvatechnologies.co.ke>
SUPPORT_EMAIL=support@sylvatechnologies.co.ke
SALES_EMAIL=sales@sylvatechnologies.co.ke
ADMIN_EMAIL=admin@sylvatechnologies.co.ke

# SMS and OTP
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=SYLVA
OTP_EXPIRY_MINUTES=10
RESEND_COOLDOWN_MINUTES=1
MAX_OTP_ATTEMPTS=5
MAX_OTP_REQUESTS=3
WHATSAPP_NUMBER=254700932014

# M-Pesa
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TILL_NUMBER=
# Leave blank to allow the application to determine the transaction type.
# Common values: CustomerPayBillOnline or CustomerBuyGoodsOnline
MPESA_TRANSACTION_TYPE=
MPESA_ORDER_CALLBACK_URL=https://sylva-technologies-backend.onrender.com/api/orders/mpesa/callback
MPESA_CALLBACK_URL=https://sylva-technologies-backend.onrender.com/api/wallet/topup/stk/callback

# PayPal checkout
PAYPAL_EMAIL=
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
FRONTEND_URL=https://www.sylvatechnologies.co.ke
PAYPAL_KES_PER_USD=129.95

# Wallet and commission
WALLET_KES_PER_USD=
PLATFORM_COMMISSION_RATE_BPS=400

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail attachment encryption
MAIL_ATTACHMENT_ENCRYPTION_KEY=

# Optional IntaSend configuration (not activated by this template)
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
INTASEND_ENV=sandbox
